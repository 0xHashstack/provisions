# Environment Configuration
# Options: 'mainnet' | 'testnet'
NEXT_PUBLIC_NODE_ENV=mainnet

# WalletConnect Project ID (Required for wallet connection)
# Get one from https://cloud.walletconnect.com/
NEXT_PUBLIC_WALLETCONNECT_PROJECTOR=

# RPC Providers
# Ethereum Mainnet RPC
NEXT_PUBLIC_INFURA_MAINNET=https://mainnet.infura.io/v3/YOUR_KEY
# Base Testnet RPC (if using testnet)
NEXT_PUBLIC_INFURA_TESTNET_BASE=https://sepolia.base.org

# Starknet RPCs
# Note: We recently switched the app to use 1rpc.io by default in RootContext, 
# but these are still referenced in stark-constants.ts
NEXT_PUBLIC_INFURA_MAINNET_STARKNET=https://starknet-mainnet.infura.io/v3/YOUR_KEY
NEXT_PUBLIC_INFURA_TESTNET_STARKNET=https://starknet-sepolia.infura.io/v3/YOUR_KEY

# Token Addresses (Mainnet)
NEXT_PUBLIC_MC_USDT=0xdAC17F958D2ee523a2206206994597C13D831ec7
NEXT_PUBLIC_MC_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
NEXT_PUBLIC_MC_PRESALE=

# Token Addresses (Testnet)
NEXT_PUBLIC_TC_USDT=
NEXT_PUBLIC_TC_USDC=
NEXT_PUBLIC_TC_PRESALE=
